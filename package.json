{
  "name": "millrect",
  "version": "0.1.20",
  "description": "Millrect",
  "license": "MIT",
  "author": "JIROMO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JIROMO/Millrect.git"
  },
  "bugs": {
    "url": "https://github.com/JIROMO/Millrect/issues"
  },
  "homepage": "https://github.com/JIROMO/Millrect",
  "scripts": {
    "build:text-engine": "node scripts/build-text-engine-browser.js",
    "build:app-js": "node scripts/build-app-js.js",
    "build:stl-wasm": "node scripts/build-stl-wasm.js",
    "fonts:fetch": "node scripts/fetch-web-fonts.js",
    "serve": "npm run build:app-js && node scripts/static-server.js",
    "serve:worker": "npm run dev",
    "build:site": "node scripts/build-site.js",
    "dev": "npm run build:site && npm --prefix worker run dev",
    "verify:contours": "node scripts/verify-text-contour-sources.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test": "npm run verify:contours && npm run test:unit && npm run test:integration",
    "build": "npm run build:text-engine && npm run build:stl-wasm && npm run build:site && npm --prefix worker run build",
    "deploy": "npm run build:site && npm --prefix worker run deploy",
    "format": "npx prettier --write \"**/*.js\"",
    "docs:screenshots": "node scripts/capture-docs-screenshots.js",
    "seo:sitemap": "node scripts/generate-sitemap.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.1",
    "harfbuzzjs": "^1.2.0"
  }
}
