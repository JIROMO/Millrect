{
  "$schema": "worker/node_modules/wrangler/config-schema.json",
  "name": "millrect",
  "account_id": "64d76a10fff6e7e52e63a365ce399877",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    // scripts/site-manifest.js（build:site）が組み立てる、デプロイ対象そのままの
    // ディレクトリ。リポジトリ直下を丸ごと指定すると node_modules 等の巨大ファイルまで
    // 静的アセットとして拾ってしまうため使わない。build:site を先に実行しておくこと。
    "directory": "dist/site",
    "binding": "ASSETS",
    // ルーティングはHono（worker/src/index.ts）が一元的に行う。run_worker_first:true
    // にしないと、Cloudflareの既定動作でまず静的アセットが先に判定されてしまい、
    // /mcp が静的ファイル探索をすり抜けてWorkerに届かない。
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRelay"] }
  ],
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "millrect-usage",
      "database_id": "952f6819-d12b-458d-a189-a8676c02ab97",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Delete raw IP addresses after 30 days while retaining enough history to
    // answer whether the web app is actively used.
    "crons": ["17 3 * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
